# ===============================================================================
# Chalwk's generic .gitattributes
#
# Copy-pasted across all my projects. Some entries below are redundant against
# the `* text=auto eol=lf` fallback, but I like to be explicit so the intended
# policy is obvious at a glance and locked against future changes to the default.
# ===============================================================================


# ===============================================================================
# Default: normalize text files to LF, leave binaries alone
# ===============================================================================
* text=auto eol=lf
# ===============================================================================


# ===============================================================================
# Windows-native scripts
# ===============================================================================
*.bat text eol=crlf
*.cmd text eol=crlf


# ===============================================================================
# POSIX wrapper script
# ===============================================================================
gradlew text eol=lf


# ===============================================================================
# Source and config (explicit LF; defensive against content sniffing misfires)
# ===============================================================================
## Kotlin / Java / Android
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.pro text eol=lf

## Data and config formats
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf

## Documentation
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf

## Web
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.svg text eol=lf

## Scripts and interpreted languages
*.lua text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.sh text eol=lf

## Git config dotfiles
.gitignore text eol=lf
.gitattributes text eol=lf


# ===============================================================================
# Binaries
# ===============================================================================
## Archives and build artifacts
*.jar binary
*.zip binary
*.apk binary
*.aab binary
*.pyc binary

## Windows binaries
*.dll binary
*.exe binary
*.pdb binary

## Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary

## Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

## Native libraries
*.so binary

## Signing material (gitignored, but binary-marked as belt and braces)
*.jks binary
*.keystore binary
*.p12 binary
*.pfx binary

# ===============================================================================
# GitHub language detection hints
# ===============================================================================
*.kts linguist-language=Kotlin
gradlew linguist-vendored
gradlew.bat linguist-vendored
gradle/wrapper/** linguist-vendored