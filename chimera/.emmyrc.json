{
  "runtime": {
    "version": "Lua5.5"
  },
  "workspace": {
    "library": [
      "${workspaceFolder}/../reference/apis"
    ],
    "packageDirs": [
      "chimera"
    ]
  },
  "diagnostics": {
    "workspaceDelay": -1,
    "workspaceEvent": "None",
    "enable": true,
    "disable": [
      "undefined-global"
    ]
  }
}